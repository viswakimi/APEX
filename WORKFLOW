create table EMP
(
  empno      NUMBER generated by default on null as identity (start with 8000),
  emp_name   VARCHAR2(1000),
  mgr        NUMBER(4),
  hr_mgr     VARCHAR2(1000),
  emp_email  VARCHAR2(1000),
  mgr_email  VARCHAR2(1000),
  task_id    NUMBER,
  created_on DATE
);

-- Create table
create table EMP_LEAVES
(
  emp_leave_id  NUMBER generated by default on null as identity (start with 8000),
  emp_no        NUMBER not null,
  leave_balance NUMBER,
  leave_type    VARCHAR2(300),
  days          VARCHAR2(300),
  wf_id         NUMBER,
  task_id       NUMBER,
  updated_on    DATE,
  created_on    DATE,
  comments      VARCHAR2(300)
);

