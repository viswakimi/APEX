--------------Switch Statement ---
BEGIN
 -- when no supervisor then raise excpetion
  SELECT EMP_NAME, EMP_EMAIL, hr_MGR
    INTO :SUPERVISOR_NAME, :SUPERVISOR_EMAIL, :SUPERVISOR_ID
    FROM EMP_1
   WHERE EMPNO = :SUPERVISOR_ID;

  RETURN TRUE;

EXCEPTION
  WHEN OTHERS THEN
    :SUPERVISOR_ID := NULL;
    RETURN FALSE;
END;
